Windows Registry Editor Version 5.00

; ========================================================
; GOOGLE CHROME - ADULT CONTENT, INCOGNITO, DOH DISABLE & DOMAIN BLOCK
; ========================================================
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"IncognitoModeAvailability"=dword:00000001
"ForceGoogleSafeSearch"=dword:00000001
"SafeSitesFilterBehavior"=dword:00000001
"DnsOverHttpsMode"="off"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\URLBlocklist]
"1"="*fboxtv.org*"
"2"="*twimg.com*"
"3"="*pbs.twimg.com*"
"4"="*video.twimg.com*"
"5"="*abs.twimg.com*"

; ========================================================
; MICROSOFT EDGE - ADULT CONTENT, INPRIVATE, DOH DISABLE & DOMAIN BLOCK
; ========================================================
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"InPrivateModeAvailability"=dword:00000001
"ForceGoogleSafeSearch"=dword:00000001
"DnsOverHttpsMode"="off"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\URLBlocklist]
"1"="*fboxtv.org*"
"2"="*twimg.com*"
"3"="*pbs.twimg.com*"
"4"="*video.twimg.com*"
"5"="*abs.twimg.com*"

; ========================================================
; WINDOWS NETWORK - BLOCK ADDING VPN CONNECTIONS & PROXIES
; ========================================================
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Network Connections]
"NC_NewConnectionWizard"=dword:00000001
"NC_DeleteAllUserConnection"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Internet Explorer\Control Panel]
"Proxy"=dword:00000001
"Connwiz Admin Lock"=dword:00000001

; ========================================================
; WINDOWS SERVICES - DISABLE WINDOWS VPN SERVICE (RASMAN)
; ========================================================
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\RasMan]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\RasAuto]
"Start"=dword:00000004
