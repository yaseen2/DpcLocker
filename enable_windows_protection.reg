; ========================================================
; MICROSOFT EDGE - INPRIVATE LOCK, SAFESEARCH, PROXY DIRECT, EXTENSION LOCK
; ========================================================
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"InPrivateModeAvailability"=dword:00000001
"ForceGoogleSafeSearch"=dword:00000001
"ForceYouTubeRestrict"=dword:00000000
"DnsOverHttpsMode"="off"
"ProxyMode"="direct"
"BlockExternalExtensions"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Edge]
"InPrivateModeAvailability"=dword:00000001

