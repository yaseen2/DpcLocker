Windows Registry Editor Version 5.00

; ========================================================
; PURGE ALL FORCED EXTENSIONS FROM CHROME, EDGE & BRAVE
; ========================================================
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
[-HKEY_CURRENT_USER\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
[-HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\BraveSoftware\Brave\ExtensionInstallForcelist]
[-HKEY_CURRENT_USER\SOFTWARE\Policies\BraveSoftware\Brave\ExtensionInstallForcelist]

; ========================================================
; GOOGLE CHROME - INCOGNITO LOCK, SAFESEARCH, PROXY DIRECT, EXTENSION LOCK
; ========================================================
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"IncognitoModeAvailability"=dword:00000001
"ForceGoogleSafeSearch"=dword:00000001
"SafeSitesFilterBehavior"=dword:00000001
"ForceYouTubeRestrict"=dword:00000000
"DnsOverHttpsMode"="off"
"ProxyMode"="direct"
"BlockExternalExtensions"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Policies\Google\Chrome]
"IncognitoModeAvailability"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallBlocklist]
"1"="*"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\URLBlocklist]
"1"="*fboxtv.org*"
"2"="*x.com*"
"3"="*twitter.com*"
"4"="*twimg.com*"
"5"="*redd.it*"
"6"="*tumblr.com*"
"7"="*telegram.org*"
"8"="*t.me*"
